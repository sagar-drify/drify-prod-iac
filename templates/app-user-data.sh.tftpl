#!/bin/bash
set -euxo pipefail
exec > >(tee -a /var/log/drify-bootstrap.log) 2>&1

dnf install -y nginx docker rsync tar gzip xz jq postgresql16

curl -fsSL "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-x64.tar.xz" \
  | tar -xJ -C /usr/local --strip-components=1
/usr/local/bin/npm install -g pm2

id drify >/dev/null 2>&1 || useradd --system --create-home --home-dir /opt/drify --shell /bin/bash drify
mkdir -p /opt/drify/customer /opt/drify/rider /opt/drify/admin
chown -R drify:drify /opt/drify
env PATH=/usr/local/bin:/usr/bin:/bin /usr/local/bin/pm2 startup systemd -u drify --hp /opt/drify

systemctl enable --now docker
RABBITMQ_PASSWORD=$(aws secretsmanager get-secret-value --region "${region}" \
  --secret-id "${rabbitmq_secret_id}" --query SecretString --output text | jq -r .password)
docker run -d --name rabbitmq --restart unless-stopped \
  -p 127.0.0.1:5672:5672 -p 127.0.0.1:15672:15672 \
  -e RABBITMQ_DEFAULT_USER=drifyv2 -e RABBITMQ_DEFAULT_PASS="$RABBITMQ_PASSWORD" \
  -v rabbitmq-data:/var/lib/rabbitmq \
  rabbitmq:4-management
unset RABBITMQ_PASSWORD

REDIS_PASSWORD=$(aws secretsmanager get-secret-value --region "${region}" \
  --secret-id "${redis_secret_id}" --query SecretString --output text | jq -r .password)
docker run -d --name redis --restart unless-stopped \
  -p 127.0.0.1:6379:6379 \
  -v redis-data:/data \
  redis:7.2 \
  redis-server --requirepass "$REDIS_PASSWORD" --appendonly yes
unset REDIS_PASSWORD

cat > /etc/nginx/conf.d/drify.conf <<'NGINX'
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;
  location = /nginx-health { return 200 "ok\n"; }
  location / { return 404; }
}

server {
  listen 80;
  server_name ${api_domain};
  client_max_body_size 10m;
  location / {
    proxy_pass http://127.0.0.1:4100;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 3600s;
  }
}

server {
  listen 80;
  server_name ${rider_domain};
  client_max_body_size 10m;
  location / {
    proxy_pass http://127.0.0.1:5001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 3600s;
  }
}

server {
  listen 80;
  server_name ${admin_domain};
  client_max_body_size 10m;
  location / {
    proxy_pass http://127.0.0.1:5002;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 3600s;
  }
}
NGINX

nginx -t
systemctl enable --now nginx
touch /var/lib/drify-bootstrap-complete
