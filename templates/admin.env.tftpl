# Seeded by Terraform. Add third-party keys here; later applies keep edits.
NODE_ENV=production
LOG_LEVEL=info
PORT=5002

DB_Name=${postgres_database}
DB_UserName=${postgres_user}
DB_Password=${postgres_password}
DB_Host=${postgres_host}
PG_PORT=5432
PG_DUMP_PATH=/usr/bin/pg_dump
PG_PSQL_PATH=/usr/bin/psql
BACKUP_FOLDER=./backups

REDIS_URL=${redis_url}
JWT_SECRET=${jwt_secret}
SESSION_SECRET=${admin_session_secret}
ENABLE_SOCKET_REDIS_ADAPTER=true
SOCKET_ADAPTER_KEY=${socket_adapter_key}
ENABLE_WORKERS=false
ENABLE_ZOHO_WORKER=false
ENABLE_CRONS=false

AWS_REGION=${aws_region}
BASEURL=https://${admin_domain}

# Fill these before the related features can work.
SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=
