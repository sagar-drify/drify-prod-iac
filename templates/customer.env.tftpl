# Seeded by Terraform. Add third-party keys here; later applies keep edits.
NODE_ENV=production
LOG_LEVEL=info

DATABASE_HOST=${postgres_host}:5432
DATABASE_USER=${postgres_user}
DATABASE_PASSWORD=${postgres_password}
DATABASE_URL_WRITE=${postgres_url_base}?connection_limit=6
DATABASE_URL_READ=${postgres_url_base}?connection_limit=6
AUTH_DATABASE_URL_WRITE=${postgres_url_base}?schema=auth&connection_limit=6
AUTH_DATABASE_URL_READ=${postgres_url_base}?schema=auth&connection_limit=6
USER_DATABASE_URL_WRITE=${postgres_url_base}?schema=users&connection_limit=6
USER_DATABASE_URL_READ=${postgres_url_base}?schema=users&connection_limit=6
PAYMENT_DATABASE_URL_WRITE=${postgres_url_base}?schema=payments&connection_limit=6
PAYMENT_DATABASE_URL_READ=${postgres_url_base}?schema=payments&connection_limit=6
NOTIFICATION_DATABASE_URL_WRITE=${postgres_url_base}?schema=notifications&connection_limit=6
NOTIFICATION_DATABASE_URL_READ=${postgres_url_base}?schema=notifications&connection_limit=6
STORE_DATABASE_URL_WRITE=${postgres_url_base}?schema=stores&connection_limit=6
STORE_DATABASE_URL_READ=${postgres_url_base}?schema=stores&connection_limit=6

GATEWAY_PORT=4100
AUTH_SERVICE_PORT=4101
USER_SERVICE_PORT=4102
CART_SERVICE_PORT=4103
PAYMENT_SERVICE_PORT=4104
NOTIFICATION_SERVICE_PORT=4105
STORE_SERVICE_PORT=4106
RATING_SERVICE_PORT=4107
MASTER_SERVICE_PORT=4108
ORDER_SERVICE_PORT=4109
SUPPORT_SERVICE_PORT=4110
CONTENT_SERVICE_PORT=4111
FAVORITE_SERVICE_PORT=4112
REPORT_SERVICE_PORT=4113
TRACKING_SERVICE_PORT=4114

AUTH_SERVICE_URL=http://127.0.0.1:4101
USER_SERVICE_URL=http://127.0.0.1:4102
CART_SERVICE_URL=http://127.0.0.1:4103
PAYMENT_SERVICE_URL=http://127.0.0.1:4104
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4105
STORE_SERVICE_URL=http://127.0.0.1:4106
RATING_SERVICE_URL=http://127.0.0.1:4107
MASTER_SERVICE_URL=http://127.0.0.1:4108
ORDER_SERVICE_URL=http://127.0.0.1:4109
SUPPORT_SERVICE_URL=http://127.0.0.1:4110
CONTENT_SERVICE_URL=http://127.0.0.1:4111
FAVORITE_SERVICE_URL=http://127.0.0.1:4112
REPORT_SERVICE_URL=http://127.0.0.1:4113
TRACKING_SERVICE_URL=http://127.0.0.1:4114
RIDER_SOCKET_URL=http://127.0.0.1:5001

JWT_SECRET=${jwt_secret}
JWT_REFRESH_SECRET=${jwt_refresh_secret}
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=drifyv2
JWT_AUDIENCE=drifyv2-api
INTERNAL_SERVICE_TOKEN=${internal_service_token}

HTTP_TIMEOUT_MS=5000
HTTP_MAX_RETRIES=2
CIRCUIT_BREAKER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=15000

CORS_ORIGINS=https://${api_domain}
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT=100kb
ENABLE_TEST_OTP=false

MASTER_IMPORT_MAX_BYTES=2000000
MASTER_IMPORT_MAX_ROWS=2000
STORE_IMPORT_MAX_BYTES=2000000
STORE_IMPORT_MAX_ROWS=3000

RABBITMQ_USER=drifyv2
RABBITMQ_PASSWORD=${rabbitmq_password}
RABBITMQ_URL=${rabbitmq_url}
REDIS_URL=${redis_url}
REDIS_KEY_PREFIX=

# Fill these before the related services can start or send real traffic.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_DESK_API_URL=https://desk.zoho.in/api/v1
ZOHO_DESK_ORG_ID=
ZOHO_DESK_DEPARTMENT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DESK_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_PATH=
