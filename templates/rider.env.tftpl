# Seeded by Terraform. Add third-party keys here; later applies keep edits.
NODE_ENV=production
PORT=5001

DB_N=${postgres_database}
DB_U=${postgres_user}
DB_P=${postgres_password}
DB_H=${postgres_host}

REDIS_URL=${redis_url}
REDIS_KEY_PREFIX=

JWT_SECRET=${jwt_secret}
RIDER_JWT_SECRET=${rider_jwt_secret}
RIDER_JWT_EXPIRES_IN=7d
VENDOR_JWT_SECRET=${vendor_jwt_secret}
VENDOR_JWT_EXPIRES_IN=7d
JWT_ISSUER=drifyv2
JWT_AUDIENCE=drifyv2-api

SOCKET_REQUIRE_RIDER_AUTH=true
ENABLE_SOCKET_REDIS_ADAPTER=true
SOCKET_ADAPTER_KEY=${socket_adapter_key}
PROTECT_OPEN_RIDER_ROUTES=true
ENABLE_TEST_OTP=false
ENABLE_WORKERS=false
ENABLE_CRONS=false
ENABLE_DOORDASH_ROUTES=false

AWS_REGION=${aws_region}
BASEURL=https://${rider_domain}

# Fill these before the related features can work.
SECRET_KEY=
S3_PUBLIC_BASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
